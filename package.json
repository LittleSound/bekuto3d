{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build",
    "packages:build": "pnpm -F './packages/*' run build",
    "dev": "vite --port 3333",
    "lint": "eslint .",
    "typecheck": "vue-tsc",
    "preview": "vite preview",
    "test": "vitest",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks"
  },
  "dependencies": {
    "@tresjs/cientos": "^5.9.3",
    "@tresjs/core": "^5.9.3",
    "@vueuse/core": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "fix-path-directions": "^1.0.5",
    "jszip": "^3.10.2",
    "potrace": "^2.1.8",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/iconoir": "^1.2.12",
    "@types/node": "^24.19.2",
    "@types/potrace": "^2.1.5",
    "@types/three": "^0.186.0",
    "@unocss/eslint-config": "^66.11.0",
    "@unocss/eslint-plugin": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.3.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "unocss": "^66.11.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
